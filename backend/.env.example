APP_ENV=development
APP_NAME="Housing Society CMS"
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
APP_TIMEZONE="Asia/Karachi"
LOG_LEVEL=INFO

# Supabase PostgreSQL Connection String
# 1. Direct Connection (Default):
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.kepjnmrrtvofdpzwpvqa.supabase.co:5432/postgres
DATABASE_MIGRATION_URL=postgresql://postgres:[YOUR-PASSWORD]@db.kepjnmrrtvofdpzwpvqa.supabase.co:5432/postgres

# 2. Connection Pooler (Alternative if your local ISP blocks IPv6 or port 5432):
# In Supabase Connect modal, select "Transaction pooler", port 6543:
# DATABASE_URL=postgresql+asyncpg://postgres.kepjnmrrtvofdpzwpvqa:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?prepared_statement_cache_size=0
# DATABASE_MIGRATION_URL=postgresql://postgres.kepjnmrrtvofdpzwpvqa:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Supabase Auth Configuration (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://kepjnmrrtvofdpzwpvqa.supabase.co
SUPABASE_JWKS_URL=https://kepjnmrrtvofdpzwpvqa.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://kepjnmrrtvofdpzwpvqa.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage Bucket
SUPABASE_STORAGE_BUCKET=complaint-attachments

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
