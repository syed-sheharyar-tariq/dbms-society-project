# ==============================================================================
# Housing Society Complaint Management System (CMS) - Environment Configuration
# Copy this file to .env and configure with your Supabase and deployment details.
# NEVER commit actual secrets to version control.
# ==============================================================================

# --- Frontend Environment Variables (Public, bundled into client) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Backend Application Configuration ---
APP_ENV=development
APP_NAME=Housing Society CMS
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
APP_TIMEZONE=Asia/Karachi
LOG_LEVEL=INFO

# --- Database Configuration ---
# Direct connection for migrations (Alembic) and connection pooling
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres
DATABASE_MIGRATION_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# --- Supabase Auth & JWT Configuration ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project-id.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# --- CORS Allowed Origins (Comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Supabase Storage (Attachments) ---
SUPABASE_STORAGE_BUCKET=complaint-attachments

# --- Optional Integrations ---
EMAIL_PROVIDER_API_KEY=
WHATSAPP_API_TOKEN=
